---
import "../styles/global.css";
import { Archive, Code2, Info, Network, Newspaper, Search } from "@lucide/astro";
import BrandLogo from "../components/BrandLogo.astro";
import { sitePath } from "../lib/paths";
const { title = "RecSys Daily" } = Astro.props;
const currentPath = Astro.url.pathname;
const repositoryUrl = "https://github.com/Bin-Zhang-hhht/rec-sys-daily";
const isActive = (path: string) => currentPath.startsWith(sitePath(path));
const isHome = currentPath === sitePath();
const navLinkClass = "inline-flex h-10 min-w-10 items-center justify-center gap-2 rounded-md px-2.5 text-slate-600 no-underline transition-colors hover:bg-slate-100 hover:text-slate-950 hover:no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#172033" />
    <link rel="icon" type="image/svg+xml" href={sitePath("favicon.svg")} />
    <title>{title}</title>
  </head>
  <body>
    <header class="sticky top-0 z-40 border-b border-slate-200/90 bg-white/95 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 text-sm sm:px-5" aria-label="主导航">
        <a href={sitePath()} class="inline-flex shrink-0 items-center gap-2.5 text-slate-950 no-underline hover:no-underline" aria-label="RecSys Daily 首页">
          <BrandLogo class="h-9 w-9 shrink-0" />
          <span class="hidden leading-tight sm:block">
            <span class="block font-semibold">RecSys Daily</span>
            <span class="block text-[0.68rem] text-slate-500">推荐系统研究日报</span>
          </span>
        </a>
        <div class="flex items-center gap-0.5 sm:gap-1">
          <a class:list={[navLinkClass, isHome && "bg-slate-100 text-slate-950"]} href={sitePath()} aria-current={isHome ? "page" : undefined} aria-label="日报" title="日报">
            <Newspaper size={18} stroke-width={1.8} aria-hidden="true" />
            <span class="hidden md:inline">日报</span>
          </a>
          <a class:list={[navLinkClass, isActive("archive/") && "bg-slate-100 text-slate-950"]} href={sitePath("archive/")} aria-current={isActive("archive/") ? "page" : undefined} aria-label="归档" title="归档">
            <Archive size={18} stroke-width={1.8} aria-hidden="true" />
            <span class="hidden md:inline">归档</span>
          </a>
          <a class:list={[navLinkClass, isActive("search/") && "bg-slate-100 text-slate-950"]} href={sitePath("search/")} aria-current={isActive("search/") ? "page" : undefined} aria-label="搜索" title="搜索">
            <Search size={18} stroke-width={1.8} aria-hidden="true" />
            <span class="hidden md:inline">搜索</span>
          </a>
          <a class:list={[navLinkClass, isActive("graph/") && "bg-slate-100 text-slate-950"]} href={sitePath("graph/")} aria-current={isActive("graph/") ? "page" : undefined} aria-label="图谱" title="图谱">
            <Network size={18} stroke-width={1.8} aria-hidden="true" />
            <span class="hidden md:inline">图谱</span>
          </a>
          <a class:list={[navLinkClass, isActive("about/") && "bg-slate-100 text-slate-950"]} href={sitePath("about/")} aria-current={isActive("about/") ? "page" : undefined} aria-label="关于" title="关于">
            <Info size={18} stroke-width={1.8} aria-hidden="true" />
            <span class="hidden md:inline">关于</span>
          </a>
          <a class={navLinkClass} href={repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub 代码仓库" title="GitHub 代码仓库">
            <Code2 size={18} stroke-width={1.8} aria-hidden="true" />
            <span class="hidden md:inline">代码</span>
          </a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-9 sm:px-5 md:py-12"><slot /></main>
  </body>
</html>
