---
import type { DigestEntry, Item, Taxonomy } from "../lib/data";
import { taxonomyGroups, taxonomyName } from "../lib/data";
import { itemPath } from "../lib/paths";
const { item, taxonomy, entry } = Astro.props as { item: Item; taxonomy: Taxonomy; entry?: DigestEntry };
const href = itemPath(item);
const basisLabels: Record<string, string> = {
  mineru_full_text: "MinerU 全文",
  abstract_fallback: "Abstract 降级",
  rss_full_content: "RSS 全文",
  article_html: "Article HTML",
  excerpt_fallback: "Excerpt 降级",
};
---
<article class="border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-2 flex items-center justify-between text-xs text-slate-500"><span>{entry ? `#${entry.rank} · ` : ""}{item.kind === "paper" ? "Paper" : "Engineering Blog"}</span><time datetime={item.published_at}>{item.published_at.slice(0, 10)}</time></div>
  <h3 class="text-lg font-semibold"><a href={href}>{item.title}</a></h3>
  <p class="prose-lite mt-2 text-sm text-slate-700">{item.summary_zh}</p>
  {entry && <p class="mt-3 text-sm text-slate-600"><strong>推荐理由：</strong>{entry.recommendation_reason_zh}</p>}
  <dl class="mt-3 grid gap-2 text-xs text-slate-500 sm:grid-cols-2">
    <div><dt class="inline">来源：</dt><dd class="inline">{item.source}</dd></div>
    <div><dt class="inline">作者：</dt><dd class="inline">{item.authors.join("、") || "未署名"}</dd></div>
    <div><dt class="inline">分数：</dt><dd class="inline">相关性 {item.relevance_score.toFixed(2)} · 最终 {item.final_score.toFixed(2)}</dd></div>
    <div><dt class="inline">分析：</dt><dd class="inline">{basisLabels[item.deep_reading.analysis_basis]}{item.llm?.degraded ? " · 已降级" : ""}</dd></div>
  </dl>
  <div class="mt-4 space-y-2">{taxonomyGroups.map(group => <div class="flex flex-wrap items-center gap-2 text-xs"><span class="w-12 text-slate-500">{group}</span>{item[group].map(id => <span class="tag">{taxonomyName(taxonomy, group, id).name_zh}</span>)}</div>)}</div>
  <div class="mt-4 flex gap-4 text-sm"><a href={href}>查看详情</a><a href={item.url} target="_blank" rel="noreferrer">阅读原文</a></div>
</article>
