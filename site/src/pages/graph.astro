---
import { Eye, Maximize2, RotateCcw, Search, SlidersHorizontal } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadBundle } from "../lib/data";
import { sitePath } from "../lib/paths";
const data = loadBundle();
const years = [...new Set(data.items.map(item => item.published_at.slice(0, 4)))].sort().reverse();
const groupLabels = { targets: "目标", scenarios: "场景", tasks: "任务", methods: "方法" } as const;
const groupStyles = {
  targets: "border-sky-200 bg-sky-50 text-sky-800 has-[:checked]:border-sky-500 has-[:checked]:bg-sky-100",
  scenarios: "border-emerald-200 bg-emerald-50 text-emerald-800 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-100",
  tasks: "border-amber-200 bg-amber-50 text-amber-900 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-100",
  methods: "border-violet-200 bg-violet-50 text-violet-800 has-[:checked]:border-violet-500 has-[:checked]:bg-violet-100",
} as const;
const graphLegend = [
  { type: "paper", label: "论文", swatch: "bg-slate-300", icon: "icons/graph/paper.svg" },
  { type: "blog", label: "技术博客", swatch: "bg-slate-400", icon: "icons/graph/blog.svg" },
  { type: "target", label: "目标", swatch: "bg-sky-500" },
  { type: "scenario", label: "场景", swatch: "bg-emerald-500" },
  { type: "task", label: "任务", swatch: "bg-amber-500" },
  { type: "method", label: "方法", swatch: "bg-violet-500" },
] as const;
---
<BaseLayout title="知识图谱 / RecSys Daily">
  <section class="border-b border-slate-200 pb-5">
    <p class="text-sm font-medium text-sky-700">Knowledge Graph</p>
    <h1 class="mt-2 text-3xl font-bold">推荐系统研究图谱</h1>
    <p class="mt-3 max-w-3xl text-slate-600">按目标、场景、任务和方法浏览近期高相关内容。</p>
  </section>

  <section class="mt-6 rounded-lg border border-slate-200 bg-white p-4 shadow-sm" aria-label="图谱控制">
    <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] lg:grid-cols-[minmax(18rem,1fr)_minmax(20rem,22rem)_auto] lg:items-end">
      <div class="relative sm:col-span-2 lg:col-span-1">
        <label for="graph-query" class="block text-sm font-medium text-slate-800">
          定位节点
          <span class="relative mt-2 block">
            <Search aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" />
            <input
              id="graph-query"
              type="search"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="graph-search-results"
              aria-expanded="false"
              class="w-full rounded-md border border-slate-300 py-2 pl-10 pr-3 text-sm"
              placeholder="标题或标签"
              autocomplete="off"
            />
          </span>
        </label>
        <ul id="graph-search-results" role="listbox" class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-72 overflow-y-auto rounded-md border border-slate-200 bg-white p-1 shadow-lg"></ul>
      </div>
      <div class="grid min-w-0 grid-cols-2 gap-2 sm:min-w-[22rem]">
        <label class="min-w-0 text-sm font-medium text-slate-800">
          发布年份
          <select form="graph-filters" data-graph-time="year" class="mt-1.5 block w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm">
            <option value="">全部年份</option>
            {years.map(year => <option value={year}>{year}</option>)}
          </select>
        </label>
        <label class="min-w-0 text-sm font-medium text-slate-800">
          发布时间
          <select form="graph-filters" data-graph-time="age" class="mt-1.5 block w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm">
            <option value="">全部时间</option>
            <option value="7d">最近 7 天</option>
            <option value="30d">最近 30 天</option>
            <option value="365d">最近一年</option>
          </select>
        </label>
      </div>
      <div class="flex gap-2 sm:self-end">
        <button id="graph-fit" type="button" class="grid size-10 place-items-center rounded-md border border-slate-300 text-slate-600 hover:border-sky-500 hover:text-sky-700" aria-label="适应当前图谱" title="适应当前图谱">
          <Maximize2 aria-hidden="true" class="size-4" />
        </button>
        <button id="graph-reset" type="button" class="grid size-10 place-items-center rounded-md border border-slate-300 text-slate-600 hover:border-sky-500 hover:text-sky-700" aria-label="重置图谱" title="重置图谱">
          <RotateCcw aria-hidden="true" class="size-4" />
        </button>
        <button id="graph-show-all" type="button" class="hidden min-h-10 items-center gap-1.5 rounded-md border border-slate-300 px-2.5 text-xs font-medium text-slate-600 hover:border-sky-500 hover:text-sky-700" title="显示全图">
          <Eye aria-hidden="true" class="size-4" />显示全图
        </button>
      </div>
    </div>

    <details id="graph-filter-panel" class="mt-4 border-t border-slate-100 pt-3">
      <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-medium text-slate-700 lg:hidden">
        <span class="inline-flex items-center gap-2"><SlidersHorizontal aria-hidden="true" class="size-4" />筛选条件</span>
        <span id="graph-filter-count" class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">0</span>
      </summary>
      <form id="graph-filters" class="mt-3 grid gap-3 lg:mt-0 md:grid-cols-2 xl:grid-cols-4">
        {(["targets", "scenarios", "tasks", "methods"] as const).map(group => (
          <fieldset>
            <legend class="text-xs font-semibold text-slate-600">{groupLabels[group]}</legend>
            <div class="mt-2 flex max-h-28 flex-wrap gap-1.5 overflow-y-auto pr-1 text-xs">
              {data.taxonomy[group].map(entry => (
                <label class={`flex cursor-pointer items-center gap-1.5 rounded-full border px-2.5 py-1.5 ${groupStyles[group]}`} title={`${entry.name_zh} / ${entry.name_en}`}>
                  <input type="checkbox" value={entry.id} data-graph-filter={group} class="size-3.5" />
                  <span>{entry.name_zh}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
      </form>
    </details>
  </section>

  <div class="mt-4 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm" aria-label="知识图谱">
      <div class="relative">
        <div
          id="graph-canvas"
          class="h-[clamp(28rem,68vh,48rem)] w-full focus:outline-none focus:ring-2 focus:ring-inset focus:ring-sky-600"
          data-graph-manifest-url={sitePath("graph-manifest.json")}
          tabindex="0"
          role="region"
          aria-label="推荐系统知识图谱画布"
          aria-describedby="graph-status graph-accessible-summary"
          aria-busy="true"
        ></div>
        <div
          id="graph-type-legend"
          class="absolute left-3 top-3 z-10 flex max-w-[calc(100%_-_1.5rem)] flex-wrap gap-1 rounded-md border border-slate-200/90 bg-white/90 p-1.5 shadow-sm backdrop-blur-sm"
          role="group"
          aria-label="节点类型图例与筛选"
        >
          {graphLegend.map(entry => (
            <button
              type="button"
              data-graph-type={entry.type}
              aria-pressed="true"
              class="inline-flex h-8 items-center gap-1.5 rounded-md border border-transparent px-2 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 aria-[pressed=false]:bg-slate-100 aria-[pressed=false]:text-slate-400 aria-[pressed=false]:opacity-60"
              title={`${entry.label}节点：点击隐藏`}
            >
              {entry.icon ? <img src={sitePath(entry.icon)} alt="" class="size-4 shrink-0" aria-hidden="true" /> : <span class={`size-3 rounded-full opacity-70 ${entry.swatch}`} aria-hidden="true"></span>}
              <span>{entry.label}</span>
            </button>
          ))}
        </div>
      </div>
      <p id="graph-status" class="border-t border-slate-100 px-4 py-3 text-sm text-slate-500" role="status" aria-live="polite">正在加载图谱...</p>
      <p id="graph-accessible-summary" class="sr-only">图谱加载后，可使用上方搜索框和筛选条件定位节点，并在节点详情区域访问内容链接。</p>
    </section>
    <aside class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm lg:sticky lg:top-20 lg:max-h-[48rem] lg:overflow-y-auto">
      <p class="text-xs font-semibold text-slate-500">节点详情</p>
      <div id="graph-details" class="mt-3 text-sm text-slate-700 focus:outline-none" tabindex="-1" aria-live="polite">选择节点后显示详情。</div>
    </aside>
  </div>
  <script src="../scripts/graph.ts"></script>
</BaseLayout>
