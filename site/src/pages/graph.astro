---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadBundle } from "../lib/data";
import { sitePath } from "../lib/paths";
const data = loadBundle();
const years = [...new Set(data.items.map(item => item.published_at.slice(0, 4)))].sort().reverse();
---
<BaseLayout title="知识图谱 / RecSys Daily">
  <section class="border-b border-slate-200 pb-5">
    <p class="text-sm font-medium text-sky-700">Knowledge Graph</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">推荐系统研究图谱</h1>
    <p class="mt-3 max-w-3xl text-slate-600">按目标、场景、任务和方法浏览近期高相关内容。</p>
  </section>
  <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_18rem]">
    <section class="border border-slate-200 bg-white" aria-label="知识图谱">
      <div
        id="graph-canvas"
        class="min-h-[32rem] w-full focus:outline-none focus:ring-2 focus:ring-inset focus:ring-sky-600"
        data-graph-url={sitePath("graph.json")}
        tabindex="0"
        role="region"
        aria-label="推荐系统知识图谱画布"
      ></div>
      <p id="graph-status" class="border-t border-slate-100 px-4 py-3 text-sm text-slate-500" role="status" aria-live="polite">正在加载图谱...</p>
    </section>
    <aside class="border border-slate-200 bg-white p-4">
      <label for="graph-query" class="text-sm font-medium text-slate-800">定位节点</label>
      <input id="graph-query" type="search" class="mt-2 w-full border border-slate-300 px-3 py-2 text-sm" placeholder="标题或标签" autocomplete="off" />
      <button id="graph-show-all" type="button" class="mt-3 hidden border border-slate-300 px-3 py-1.5 text-xs">查看全图</button>
      <form id="graph-filters" class="mt-5 space-y-4">
        <fieldset>
          <legend class="text-sm font-medium">时间</legend>
          <div class="mt-2 space-y-2 text-xs">
            <select data-graph-time="year" class="w-full border border-slate-300 px-2 py-1"><option value="">全部年份</option>{years.map(year => <option value={year}>{year}</option>)}</select>
            <select data-graph-time="age" class="w-full border border-slate-300 px-2 py-1"><option value="">全部时间</option><option value="7d">最近 7 天</option><option value="30d">最近 30 天</option><option value="365d">最近一年</option></select>
          </div>
        </fieldset>
        {(["targets", "scenarios", "tasks", "methods"] as const).map(group => <fieldset><legend class="text-sm font-medium">{group}</legend><div class="mt-2 max-h-36 space-y-1 overflow-auto text-xs">{data.taxonomy[group].map(entry => <label class="block"><input type="checkbox" value={entry.id} data-graph-filter={group} /> {entry.name_zh}</label>)}</div></fieldset>)}
      </form>
      <div id="graph-details" class="mt-5 text-sm text-slate-700" aria-live="polite">选择节点后显示详情。</div>
    </aside>
  </div>
  <script src="../scripts/graph.ts"></script>
</BaseLayout>
