---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadBundle, taxonomyName } from "../../lib/data";
export function getStaticPaths() { const data = loadBundle(); return data.items.filter(item => item.kind === "blog").map(item => ({ params: { id: item.id }, props: { item, data } })); }
const { item, data } = Astro.props;
const reading = item.deep_reading;
function ageBucket(value: string) { const days = Math.max(0, (Date.now() - Date.parse(value)) / 86400000); return days <= 7 ? "7d" : days <= 30 ? "30d" : days <= 365 ? "365d" : "older"; }
const labels = [...item.targets.map(id => taxonomyName(data.taxonomy, "targets", id)?.name_zh ?? id), ...item.scenarios.map(id => taxonomyName(data.taxonomy, "scenarios", id)?.name_zh ?? id), ...item.tasks.map(id => taxonomyName(data.taxonomy, "tasks", id)?.name_zh ?? id), ...item.methods.map(id => taxonomyName(data.taxonomy, "methods", id)?.name_zh ?? id)];
---
<BaseLayout title={`${item.title} · RecSys Daily`}>
  <article data-pagefind-body class="prose-lite mx-auto max-w-4xl">
    <span class="hidden" data-pagefind-filter="kind:blog"></span><span class="hidden" data-pagefind-filter={`published_year:${item.published_at.slice(0, 4)}`}></span><span class="hidden" data-pagefind-filter={`age:${ageBucket(item.published_at)}`}></span>
    {item.targets.map(id => <span class="hidden" data-pagefind-filter={`targets:${id}`}></span>)}
    {item.scenarios.map(id => <span class="hidden" data-pagefind-filter={`scenarios:${id}`}></span>)}
    {item.tasks.map(id => <span class="hidden" data-pagefind-filter={`tasks:${id}`}></span>)}
    {item.methods.map(id => <span class="hidden" data-pagefind-filter={`methods:${id}`}></span>)}
    <p class="text-sm text-slate-500">Engineering Blog · {item.published_at.slice(0, 10)} · {item.source}</p><h1 class="mt-2 text-3xl font-bold text-slate-950">{item.title}</h1><p class="mt-4 text-lg text-slate-700">{item.summary_zh}</p>
    <div class="mt-4 flex flex-wrap gap-2">{labels.map(label => <span class="tag">{label}</span>)}</div>
    <section class="mt-8"><h2 class="text-xl font-semibold">System Context</h2><p>{reading.system_context_zh}</p><h2 class="mt-6 text-xl font-semibold">Architecture / Implementation</h2><p>{reading.architecture_zh}</p><p>{reading.implementation_zh}</p></section>
    <section class="mt-8 grid gap-6 md:grid-cols-2"><div><h2 class="text-xl font-semibold">Production Constraints</h2><ul>{(reading.production_constraints_zh ?? []).map((value: string) => <li>{value}</li>)}</ul></div><div><h2 class="text-xl font-semibold">Trade-offs & Results</h2><ul>{[...(reading.tradeoffs_zh ?? []), ...(reading.results_zh ?? [])].map((value: string) => <li>{value}</li>)}</ul></div></section>
    <section class="mt-8"><h2 class="text-xl font-semibold">Evidence</h2><p>正文依据：{reading.analysis_basis}</p>{(reading.evidence_refs ?? []).map((ref: {heading?: string; section?: string}) => <p class="text-sm text-slate-600">{ref.heading ?? ref.section}</p>)}</section>
    <p class="mt-8 border-l-4 border-amber-400 bg-amber-50 p-4 text-sm">LLM 生成，可能存在错误。请以<a href={item.url} rel="noreferrer">原文</a>为准。</p>
  </article>
</BaseLayout>
