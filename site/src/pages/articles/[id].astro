---
import { ExternalLink, Network } from "@lucide/astro";
import TaxonomyChips from "../../components/TaxonomyChips.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadBundle, relatedItems } from "../../lib/data";
import { isExcerptTruncated, normalizeDisplayNewlines } from "../../lib/display-text";
import { itemPath, sitePath } from "../../lib/paths";
export function getStaticPaths() {
  const data = loadBundle();
  return data.items.filter(item => item.kind === "blog").map(item => ({ params: { id: item.id }, props: { item, data } }));
}
const { item, data } = Astro.props;
const reading = item.deep_reading;
function ageBucket(value: string) {
  const days = Math.max(0, (Date.now() - Date.parse(value)) / 86400000);
  return [days <= 7 && "7d", days <= 30 && "30d", days <= 365 && "365d"].filter(Boolean) as string[];
}
const related = relatedItems(item, data.items);
const excerpt = item.excerpt ? normalizeDisplayNewlines(item.excerpt) : null;
const excerptTruncated = excerpt ? isExcerptTruncated(excerpt, data.buildConfig.max_blog_excerpt_chars) : false;
const sectionClass = "border-t border-slate-200 pt-7";
---
<BaseLayout title={`${item.title} · RecSys Daily`}>
  <article data-pagefind-body class="mx-auto max-w-6xl">
    <span class="hidden" data-pagefind-filter="kind:blog"></span><span class="hidden" data-pagefind-filter={`published_year:${item.published_at.slice(0, 4)}`}></span>{ageBucket(item.published_at).map(age => <span class="hidden" data-pagefind-filter={`age:${age}`}></span>)}
    {item.targets.map(id => <span class="hidden" data-pagefind-filter={`targets:${id}`}></span>)}
    {item.scenarios.map(id => <span class="hidden" data-pagefind-filter={`scenarios:${id}`}></span>)}
    {item.tasks.map(id => <span class="hidden" data-pagefind-filter={`tasks:${id}`}></span>)}
    {item.methods.map(id => <span class="hidden" data-pagefind-filter={`methods:${id}`}></span>)}
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,72ch)_15rem] lg:justify-center">
      <div class="min-w-0">
        <header class="border-b border-slate-200 pb-7">
          <p class="text-sm font-semibold text-emerald-700">工程博客 · {item.published_at.slice(0, 10)}</p>
          <h1 class="mt-3 break-words text-3xl font-bold leading-tight text-slate-950 md:text-4xl">{item.title}</h1>
          <p class="mt-4 text-lg leading-8 text-slate-700">{item.summary_zh}</p>
          <TaxonomyChips item={item} taxonomy={data.taxonomy} class="mt-5" />
        </header>
        <main class="prose-lite mt-8 space-y-8">
          {excerpt && <details open class="rounded-lg border border-slate-200 bg-white">
            <summary class="cursor-pointer px-5 py-4 text-sm font-semibold text-slate-900">Feed excerpt {excerptTruncated && <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-900">已截断</span>}</summary>
            <div class="max-h-[32rem] overflow-y-auto border-t border-slate-100 px-5 py-4"><p class="whitespace-pre-line text-[0.95rem] leading-7 text-slate-700">{excerpt}</p><a data-pagefind-ignore class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium" href={item.url} target="_blank" rel="noopener noreferrer">在原文中继续阅读<ExternalLink size={15} stroke-width={1.8} aria-hidden="true" /></a></div>
          </details>}
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">系统背景</h2><p class="mt-3 text-slate-700">{reading.system_context_zh ?? "未提供"}</p></section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">架构与实现</h2><p class="mt-3 text-slate-700">{reading.architecture_zh ?? "未提供"}</p>{reading.implementation_zh && <p class="mt-4 text-slate-700">{reading.implementation_zh}</p>}</section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">生产约束</h2>{reading.production_constraints_zh.length ? <ul>{reading.production_constraints_zh.map((value: string) => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">工程权衡</h2>{reading.tradeoffs_zh.length ? <ul>{reading.tradeoffs_zh.map((value: string) => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">结果</h2>{reading.results_zh.length ? <ul>{reading.results_zh.map((value: string) => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">可复用经验</h2>{reading.lessons_zh.length ? <ul>{reading.lessons_zh.map(value => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">局限性</h2>{reading.limitations_zh.length ? <ul>{reading.limitations_zh.map(value => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">业务启示</h2>{reading.business_implications_zh.length ? <ul>{reading.business_implications_zh.map(value => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">证据定位</h2>{reading.evidence_refs.length ? <ul>{reading.evidence_refs.map(ref => <li>{ref.heading ?? ref.section}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          {related.length > 0 && <section data-pagefind-ignore class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">相关内容</h2><ul>{related.map(value => <li><a href={itemPath(value)}>{value.title}</a></li>)}</ul></section>}
          <div data-pagefind-ignore class="flex flex-wrap gap-3 border-t border-slate-200 pt-7 text-sm font-medium"><a class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-2" href={sitePath(`graph/?center=${encodeURIComponent(item.id)}`)}><Network size={16} stroke-width={1.8} aria-hidden="true" />在图谱中查看</a><a class="inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-2 text-white" href={item.url} target="_blank" rel="noopener noreferrer">阅读原文<ExternalLink size={15} stroke-width={1.8} aria-hidden="true" /></a></div>
          <p data-pagefind-ignore class="border-l-2 border-amber-400 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950">内容由 LLM 生成，可能存在错误，请以原文为准。</p>
        </main>
      </div>
      <aside class="border-t border-slate-200 pt-5 text-sm lg:sticky lg:top-24 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0">
        <h2 class="text-xs font-semibold uppercase text-slate-500">文章信息</h2>
        <dl class="mt-3 divide-y divide-slate-200 border-y border-slate-200"><div class="py-3"><dt class="text-xs text-slate-500">来源</dt><dd class="mt-1 break-words text-slate-800">{item.source}</dd></div><div class="py-3"><dt class="text-xs text-slate-500">作者</dt><dd class="mt-1 break-words leading-6 text-slate-800">{item.authors.join("、") || "未署名"}</dd></div><div class="py-3"><dt class="text-xs text-slate-500">分数</dt><dd class="mt-1 tabular-nums text-slate-800">相关性 {item.relevance_score.toFixed(2)}<br />最终 {item.final_score.toFixed(2)}</dd></div><div class="py-3"><dt class="text-xs text-slate-500">分析依据</dt><dd class="mt-1 text-slate-800">{reading.analysis_basis}{item.llm?.degraded ? " · 已降级" : ""}</dd></div>{item.llm && <><div class="py-3"><dt class="text-xs text-slate-500">生成模型</dt><dd class="mt-1 break-words text-slate-800">{item.llm.model}</dd></div><div class="py-3"><dt class="text-xs text-slate-500">生成时间</dt><dd class="mt-1 break-words text-slate-800">{item.llm.generated_at}</dd></div></>}</dl>
      </aside>
    </div>
  </article>
</BaseLayout>
