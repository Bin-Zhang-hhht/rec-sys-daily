---
import { ExternalLink, Network } from "@lucide/astro";
import TaxonomyChips from "../../components/TaxonomyChips.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadBundle, relatedItems } from "../../lib/data";
import { formatAcademicText } from "../../lib/display-text";
import { itemPath, sitePath } from "../../lib/paths";
export function getStaticPaths() {
  const data = loadBundle();
  return data.items.filter(item => item.kind === "paper").map(item => ({ params: { id: item.id }, props: { item, data } }));
}
const { item, data } = Astro.props;
const reading = item.deep_reading;
function ageBucket(value: string) {
  const days = Math.max(0, (Date.now() - Date.parse(value)) / 86400000);
  return [days <= 7 && "7d", days <= 30 && "30d", days <= 365 && "365d"].filter(Boolean) as string[];
}
const related = relatedItems(item, data.items);
const abstract = formatAcademicText(item.abstract);
const sectionClass = "border-t border-slate-200 pt-7";
---
<BaseLayout title={`${item.title} · RecSys Daily`}>
  <article data-pagefind-body class="mx-auto max-w-6xl">
    <span class="hidden" data-pagefind-filter="kind:paper"></span><span class="hidden" data-pagefind-filter={`published_year:${item.published_at.slice(0, 4)}`}></span>{ageBucket(item.published_at).map(age => <span class="hidden" data-pagefind-filter={`age:${age}`}></span>)}
    {item.targets.map(id => <span class="hidden" data-pagefind-filter={`targets:${id}`}></span>)}
    {item.scenarios.map(id => <span class="hidden" data-pagefind-filter={`scenarios:${id}`}></span>)}
    {item.tasks.map(id => <span class="hidden" data-pagefind-filter={`tasks:${id}`}></span>)}
    {item.methods.map(id => <span class="hidden" data-pagefind-filter={`methods:${id}`}></span>)}
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,72ch)_15rem] lg:justify-center">
      <div class="min-w-0">
        <header class="border-b border-slate-200 pb-7">
          <p class="text-sm font-semibold text-sky-700">论文 · {item.published_at.slice(0, 10)}</p>
          <h1 class="mt-3 break-words text-3xl font-bold leading-tight text-slate-950 md:text-4xl">{item.title}</h1>
          <p class="mt-4 text-lg leading-8 text-slate-700">{item.summary_zh}</p>
          <TaxonomyChips item={item} taxonomy={data.taxonomy} class="mt-5" />
        </header>
        <main class="prose-lite mt-8 space-y-8">
          <section><h2 class="text-xl font-semibold text-slate-950">Abstract</h2><p class="mt-3 whitespace-pre-line text-[1.02rem] leading-8 text-slate-700">{abstract}</p></section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">研究问题</h2><p class="mt-3 text-slate-700">{reading.problem_zh ?? "未提供"}</p></section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">方法与架构</h2><p class="mt-3 text-slate-700">{reading.method_zh ?? "未提供"}</p></section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">主要贡献</h2>{reading.contributions_zh.length ? <ul>{reading.contributions_zh.map((value: string) => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          <section class={sectionClass}>
            <h2 class="text-xl font-semibold text-slate-950">实验与结果</h2>
            <dl class="mt-4 divide-y divide-slate-100 border-y border-slate-200 text-sm"><div class="grid gap-1 py-3 sm:grid-cols-[5rem_1fr]"><dt class="font-medium text-slate-500">数据集</dt><dd>{reading.experiments.datasets.join(", ") || "未提供"}</dd></div><div class="grid gap-1 py-3 sm:grid-cols-[5rem_1fr]"><dt class="font-medium text-slate-500">基线</dt><dd>{reading.experiments.baselines.join(", ") || "未提供"}</dd></div><div class="grid gap-1 py-3 sm:grid-cols-[5rem_1fr]"><dt class="font-medium text-slate-500">指标</dt><dd>{reading.experiments.metrics.join(", ") || "未提供"}</dd></div></dl>
            {reading.experiments.findings_zh.length ? <ul>{reading.experiments.findings_zh.map((value: string) => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供实验结论</p>}
          </section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">局限性</h2>{reading.limitations_zh.length ? <ul>{reading.limitations_zh.map(value => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">业务启示</h2>{reading.business_implications_zh.length ? <ul>{reading.business_implications_zh.map(value => <li>{value}</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          <section class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">证据定位</h2>{reading.evidence_refs.length ? <ul>{reading.evidence_refs.map(ref => <li>{ref.section} · PDF 第 {ref.page} 页</li>)}</ul> : <p class="mt-3 text-slate-500">未提供</p>}</section>
          {related.length > 0 && <section data-pagefind-ignore class={sectionClass}><h2 class="text-xl font-semibold text-slate-950">相关内容</h2><ul>{related.map(value => <li><a href={itemPath(value)}>{value.title}</a></li>)}</ul></section>}
          <div data-pagefind-ignore class="flex flex-wrap gap-3 border-t border-slate-200 pt-7 text-sm font-medium"><a class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-2" href={sitePath(`graph/?center=${encodeURIComponent(item.id)}`)}><Network size={16} stroke-width={1.8} aria-hidden="true" />在图谱中查看</a><a class="inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-2 text-white" href={item.url} target="_blank" rel="noopener noreferrer">阅读原文<ExternalLink size={15} stroke-width={1.8} aria-hidden="true" /></a></div>
          <p data-pagefind-ignore class="border-l-2 border-amber-400 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950">内容由 LLM 生成，可能存在错误，请以原文为准。</p>
        </main>
      </div>
      <aside class="border-t border-slate-200 pt-5 text-sm lg:sticky lg:top-24 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0">
        <h2 class="text-xs font-semibold uppercase text-slate-500">论文信息</h2>
        <dl class="mt-3 divide-y divide-slate-200 border-y border-slate-200"><div class="py-3"><dt class="text-xs text-slate-500">来源</dt><dd class="mt-1 break-words text-slate-800">{item.source}</dd></div><div class="py-3"><dt class="text-xs text-slate-500">作者</dt><dd class="mt-1 break-words leading-6 text-slate-800">{item.authors.join("、") || "未署名"}</dd></div><div class="py-3"><dt class="text-xs text-slate-500">分数</dt><dd class="mt-1 tabular-nums text-slate-800">相关性 {item.relevance_score.toFixed(2)}<br />最终 {item.final_score.toFixed(2)}</dd></div><div class="py-3"><dt class="text-xs text-slate-500">分析依据</dt><dd class="mt-1 text-slate-800">{reading.analysis_basis}{item.llm?.degraded ? " · 已降级" : ""}</dd></div><div class="py-3"><dt class="text-xs text-slate-500">arXiv</dt><dd class="mt-1"><a href={`https://arxiv.org/abs/${item.arxiv_id}`} target="_blank" rel="noopener noreferrer">{item.arxiv_id}</a></dd></div><div class="py-3"><dt class="text-xs text-slate-500">DOI</dt><dd class="mt-1 break-all">{item.doi ? <a href={`https://doi.org/${item.doi}`} target="_blank" rel="noopener noreferrer">{item.doi}</a> : "未提供"}</dd></div>{item.llm && <><div class="py-3"><dt class="text-xs text-slate-500">生成模型</dt><dd class="mt-1 break-words text-slate-800">{item.llm.model}</dd></div><div class="py-3"><dt class="text-xs text-slate-500">生成时间</dt><dd class="mt-1 break-words text-slate-800">{item.llm.generated_at}</dd></div></>}</dl>
      </aside>
    </div>
  </article>
</BaseLayout>
