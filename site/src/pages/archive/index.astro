---
import { BookOpen, Newspaper, RotateCcw, Search, SlidersHorizontal } from "@lucide/astro";
import TaxonomyChips from "../../components/TaxonomyChips.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createArchiveSearchText } from "../../lib/archive-search";
import { loadBundle, taxonomyGroups, taxonomyName } from "../../lib/data";
import { itemPath, sitePath } from "../../lib/paths";

const data = loadBundle();
const archiveGroups = data.digests.slice().reverse().map(digest => ({
  digest,
  papers: digest.papers.map(entry => ({ entry, item: data.byId.get(entry.item_id)! })),
  blogs: digest.blogs.map(entry => ({ entry, item: data.byId.get(entry.item_id)! })),
}));
const rows = archiveGroups.flatMap(group => [...group.papers, ...group.blogs]);
const years = [...new Set(rows.map(row => row.item.published_at.slice(0, 4)))].sort().reverse();
const groupLabels = { targets: "目标", scenarios: "场景", tasks: "任务", methods: "方法" } as const;
const archiveIconPath = sitePath("icons/koboyo/archive.svg");
const itemSearchText = (item: (typeof rows)[number]["item"], digestDate: string) => createArchiveSearchText({
  title: item.title,
  summaryZh: item.summary_zh,
  kind: item.kind,
  digestDate,
  publishedDate: item.published_at,
  taxonomy: taxonomyGroups.flatMap(group => item[group].map(id => {
    const entry = taxonomyName(data.taxonomy, group, id);
    return { id, nameZh: entry.name_zh, nameEn: entry.name_en };
  })),
});
---
<BaseLayout title="日报归档 · RecSys Daily">
  <header class="border-b border-slate-200 pb-7">
    <div class="flex items-center gap-3">
      <img src={archiveIconPath} alt="" aria-hidden="true" width="40" height="40" class="h-9 w-9 shrink-0 sm:h-10 sm:w-10" />
      <div>
        <p class="text-sm font-semibold text-sky-700">Archive</p>
        <h1 class="mt-1 text-3xl font-bold leading-tight text-slate-950">日报归档</h1>
      </div>
    </div>
    <p class="mt-3 max-w-3xl leading-7 text-slate-600">按日报日期回看论文与工程博客；输入关键词快速定位，或展开筛选组合浏览。</p>
  </header>
  <form id="archive-filters" class="mt-6 rounded-lg border border-slate-200 bg-white p-3 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
    <div class="relative flex items-center gap-2">
      <label for="archive-query" class="sr-only">搜索归档</label>
      <div class="relative min-w-0 flex-1">
        <Search class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={17} stroke-width={1.8} aria-hidden="true" />
        <input id="archive-query" type="search" autocomplete="off" class="min-h-10 w-full rounded-md border border-slate-300 bg-white py-2 pl-9 pr-3 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-sky-600 focus:ring-2 focus:ring-sky-100" placeholder="标题、摘要、标签或日期" />
      </div>
      <button type="reset" class="inline-flex min-h-10 shrink-0 items-center justify-center gap-2 rounded-md px-2.5 text-sm text-slate-600 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600" title="重置搜索与筛选" aria-label="重置搜索与筛选">
        <RotateCcw size={16} stroke-width={1.8} aria-hidden="true" />
        <span class="hidden sm:inline">重置</span>
      </button>
      <details class="group shrink-0">
        <summary class="inline-flex min-h-10 cursor-pointer list-none items-center gap-2 rounded-md border border-slate-300 bg-white px-3 text-sm font-semibold text-slate-800 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 [&::-webkit-details-marker]:hidden">
          <SlidersHorizontal size={17} stroke-width={1.8} aria-hidden="true" />
          <span>筛选</span>
          <span data-archive-selected-count class="hidden min-w-5 rounded-full bg-sky-100 px-1.5 py-0.5 text-center text-xs text-sky-800">0</span>
        </summary>
        <div class="absolute right-0 top-full z-20 mt-2 w-full max-w-3xl rounded-lg border border-slate-200 bg-white p-5 shadow-lg">
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <fieldset><legend class="text-sm font-semibold text-slate-800">内容类型</legend><div class="mt-2 grid gap-2 text-sm text-slate-700"><label class="inline-flex items-center gap-2"><input type="checkbox" value="paper" data-archive-filter="kind" /> 论文</label><label class="inline-flex items-center gap-2"><input type="checkbox" value="blog" data-archive-filter="kind" /> 工程博客</label></div></fieldset>
            <label class="text-sm font-semibold text-slate-800">发布年份<select data-archive-year class="mt-2 block min-h-9 w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-sm font-normal"><option value="">全部年份</option>{years.map(year => <option value={year}>{year}</option>)}</select></label>
            {taxonomyGroups.map(group => <fieldset><legend class="text-sm font-semibold text-slate-800">{groupLabels[group]}</legend><div class="mt-2 max-h-36 space-y-2 overflow-y-auto pr-2 text-sm text-slate-700">{data.taxonomy[group].map(entry => <label class="flex items-start gap-2"><input class="mt-0.5" type="checkbox" value={entry.id} data-archive-filter={group} /><span>{entry.name_zh}<span class="ml-1 text-xs text-slate-400">{entry.name_en}</span></span></label>)}</div></fieldset>)}
          </div>
        </div>
      </details>
    </div>
  </form>
  <p id="archive-status" class="mt-5 text-sm text-slate-500" role="status" aria-live="polite">共 {rows.length} 条推荐</p>
  <div id="archive-results" class="relative mt-6 space-y-10 md:pl-9 md:before:absolute md:before:inset-y-2 md:before:left-2 md:before:w-px md:before:bg-slate-200">
    {archiveGroups.map(({ digest, papers, blogs }) => (
      <section class="relative" data-archive-group>
        <span class="absolute -left-[2.05rem] top-2 hidden h-4 w-4 rounded-full border-4 border-[#f4f6f8] bg-sky-600 md:block" aria-hidden="true"></span>
        <header class="flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-200 pb-3"><h2 class="text-xl font-semibold text-slate-950"><time datetime={digest.date}>{digest.date}</time></h2><a class="text-sm font-medium" href={sitePath(`archive/${digest.date}/`)}>查看当日日报</a></header>
        <div class="mt-5 grid gap-7 xl:grid-cols-2">
          {([["paper", "论文", papers], ["blog", "工程博客", blogs]] as const).map(([kind, label, items]) => (
            <section data-archive-kind-section>
              <h3 class="mb-3 inline-flex items-center gap-2 text-sm font-semibold text-slate-700">{kind === "paper" ? <BookOpen size={17} stroke-width={1.8} aria-hidden="true" /> : <Newspaper size={17} stroke-width={1.8} aria-hidden="true" />}{label} · <span data-archive-kind-count>{items.length}</span></h3>
              <div class="grid gap-3">
                {items.map(({ item }) => (
                  <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)]" data-archive-item data-archive-search={itemSearchText(item, digest.date)} data-kind={item.kind} data-year={item.published_at.slice(0, 4)} data-targets={item.targets.join(" ")} data-scenarios={item.scenarios.join(" ")} data-tasks={item.tasks.join(" ")} data-methods={item.methods.join(" ")}>
                    <h4 class="font-semibold leading-6 text-slate-950"><a href={itemPath(item)}>{item.title}</a></h4>
                    <TaxonomyChips item={item} taxonomy={data.taxonomy} class="mt-3" />
                    <p class="mt-2 text-sm leading-6 text-slate-600">{item.summary_zh}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    ))}
  </div>
  <p id="archive-empty" class="mt-10 hidden rounded-lg border border-dashed border-slate-300 bg-white px-5 py-10 text-center text-slate-500">没有符合当前筛选条件的推荐。</p>
  <script src="../../scripts/archive.ts"></script>
</BaseLayout>
