---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadBundle, taxonomyGroups } from "../../lib/data";
import { sitePath } from "../../lib/paths";
const data = loadBundle();
const rows = data.digests.slice().reverse().flatMap(digest => [
  ...digest.papers.map(entry => ({ digest, entry, item: data.byId.get(entry.item_id)! })),
  ...digest.blogs.map(entry => ({ digest, entry, item: data.byId.get(entry.item_id)! })),
]);
const years = [...new Set(rows.map(row => row.item.published_at.slice(0, 4)))].sort().reverse();
---
<BaseLayout title="日报归档 · RecSys Daily">
  <section class="border-b border-slate-200 pb-5"><h1 class="text-3xl font-bold">日报归档</h1><p class="mt-3 text-slate-600">按日报日期浏览，或在全部推荐中组合筛选内容类型、年份和分类标签。</p></section>
  <form id="archive-filters" class="mt-6 grid gap-4 border border-slate-200 bg-white p-4 md:grid-cols-3 lg:grid-cols-6">
    <label class="text-sm">内容类型<select data-archive-filter="kind" class="mt-1 block w-full border border-slate-300 px-2 py-1"><option value="">全部</option><option value="paper">Paper</option><option value="blog">Engineering Blog</option></select></label>
    <label class="text-sm">发布年份<select data-archive-filter="year" class="mt-1 block w-full border border-slate-300 px-2 py-1"><option value="">全部</option>{years.map(year => <option value={year}>{year}</option>)}</select></label>
    {taxonomyGroups.map(group => <label class="text-sm">{group}<select data-archive-filter={group} class="mt-1 block w-full border border-slate-300 px-2 py-1"><option value="">全部</option>{data.taxonomy[group].map(entry => <option value={entry.id}>{entry.name_zh}</option>)}</select></label>)}
  </form>
  <p id="archive-status" class="mt-4 text-sm text-slate-500" role="status">共 {rows.length} 条推荐</p>
  <div id="archive-results" class="mt-4 grid gap-3">{rows.map(({ digest, item }) => <article class="border border-slate-200 bg-white p-4" data-archive-item data-kind={item.kind} data-year={item.published_at.slice(0, 4)} data-targets={item.targets.join(" ")} data-scenarios={item.scenarios.join(" ")} data-tasks={item.tasks.join(" ")} data-methods={item.methods.join(" ")}><div class="flex flex-wrap items-center justify-between gap-2"><h2 class="font-semibold"><a href={sitePath(`${item.kind === "paper" ? "papers" : "articles"}/${item.id}/`)}>{item.title}</a></h2><a class="text-xs" href={sitePath(`archive/${digest.date}/`)}>{digest.date} 日报</a></div><p class="mt-2 text-sm text-slate-600">{item.summary_zh}</p></article>)}</div>
  <script>
    const form = document.querySelector<HTMLFormElement>("#archive-filters");
    const status = document.querySelector<HTMLElement>("#archive-status");
    const rows = [...document.querySelectorAll<HTMLElement>("[data-archive-item]")];
    form?.addEventListener("change", () => {
      const selected = Object.fromEntries([...form.querySelectorAll<HTMLSelectElement>("select[data-archive-filter]")].map(input => [input.dataset.archiveFilter ?? "", input.value]));
      let visible = 0;
      for (const row of rows) {
        const matches = Object.entries(selected).every(([group, value]) => !value || (group === "kind" || group === "year" ? row.dataset[group] === value : (row.dataset[group] ?? "").split(" ").includes(value)));
        row.hidden = !matches;
        if (matches) visible += 1;
      }
      if (status) status.textContent = `共 ${visible} 条推荐`;
    });
  </script>
</BaseLayout>
