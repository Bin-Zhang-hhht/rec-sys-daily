---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadBundle } from "../../lib/data";
const data = loadBundle();
---
<BaseLayout title="日报归档 · RecSys Daily"><h1 class="text-3xl font-bold">日报归档</h1><div class="mt-6 grid gap-3">{data.digests.slice().reverse().map(digest => <a class="border border-slate-200 bg-white p-4" href={`/?date=${digest.date}`}>{digest.date}<span class="ml-3 text-sm text-slate-500">论文 {digest.papers.length} · 博客 {digest.blogs.length}</span></a>)}</div></BaseLayout>
