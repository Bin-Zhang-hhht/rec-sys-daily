---
import { BookOpen, Newspaper, RotateCcw, SlidersHorizontal } from "@lucide/astro";
import TaxonomyChips from "../../components/TaxonomyChips.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadBundle, taxonomyGroups } from "../../lib/data";
import { itemPath, sitePath } from "../../lib/paths";

const data = loadBundle();
const archiveGroups = data.digests.slice().reverse().map(digest => ({
  digest,
  papers: digest.papers.map(entry => ({ entry, item: data.byId.get(entry.item_id)! })),
  blogs: digest.blogs.map(entry => ({ entry, item: data.byId.get(entry.item_id)! })),
}));
const rows = archiveGroups.flatMap(group => [...group.papers, ...group.blogs]);
const years = [...new Set(rows.map(row => row.item.published_at.slice(0, 4)))].sort().reverse();
const groupLabels = { targets: "目标", scenarios: "场景", tasks: "任务", methods: "方法" } as const;
---
<BaseLayout title="日报归档 · RecSys Daily">
  <header class="border-b border-slate-200 pb-7">
    <p class="text-sm font-semibold text-sky-700">Archive</p>
    <h1 class="mt-2 text-3xl font-bold leading-tight text-slate-950">日报归档</h1>
    <p class="mt-3 max-w-3xl leading-7 text-slate-600">按日报日期回看论文与工程博客；同一分类内可多选，分类之间组合筛选。</p>
  </header>
  <form id="archive-filters" class="mt-7 rounded-lg border border-slate-200 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
      <h2 class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900"><SlidersHorizontal size={17} stroke-width={1.8} aria-hidden="true" />筛选归档</h2>
      <button type="reset" class="inline-flex min-h-9 items-center gap-2 rounded-md px-2.5 text-sm text-slate-600 hover:bg-slate-100" title="重置筛选"><RotateCcw size={16} stroke-width={1.8} aria-hidden="true" />重置</button>
    </div>
    <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
      <fieldset><legend class="text-sm font-semibold text-slate-800">内容类型</legend><div class="mt-2 grid gap-2 text-sm text-slate-700"><label class="inline-flex items-center gap-2"><input type="checkbox" value="paper" data-archive-filter="kind" /> 论文</label><label class="inline-flex items-center gap-2"><input type="checkbox" value="blog" data-archive-filter="kind" /> 工程博客</label></div></fieldset>
      <label class="text-sm font-semibold text-slate-800">发布年份<select data-archive-year class="mt-2 block min-h-9 w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-sm font-normal"><option value="">全部年份</option>{years.map(year => <option value={year}>{year}</option>)}</select></label>
      {taxonomyGroups.map(group => <fieldset><legend class="text-sm font-semibold text-slate-800">{groupLabels[group]}</legend><div class="mt-2 max-h-32 space-y-2 overflow-y-auto pr-2 text-sm text-slate-700">{data.taxonomy[group].map(entry => <label class="flex items-start gap-2"><input class="mt-0.5" type="checkbox" value={entry.id} data-archive-filter={group} /><span>{entry.name_zh}<span class="ml-1 text-xs text-slate-400">{entry.name_en}</span></span></label>)}</div></fieldset>)}
    </div>
  </form>
  <p id="archive-status" class="mt-5 text-sm text-slate-500" role="status" aria-live="polite">共 {rows.length} 条推荐</p>
  <div id="archive-results" class="relative mt-6 space-y-10 md:pl-9 md:before:absolute md:before:inset-y-2 md:before:left-2 md:before:w-px md:before:bg-slate-200">
    {archiveGroups.map(({ digest, papers, blogs }) => (
      <section class="relative" data-archive-group>
        <span class="absolute -left-[2.05rem] top-2 hidden h-4 w-4 rounded-full border-4 border-[#f4f6f8] bg-sky-600 md:block" aria-hidden="true"></span>
        <header class="flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-200 pb-3"><h2 class="text-xl font-semibold text-slate-950"><time datetime={digest.date}>{digest.date}</time></h2><a class="text-sm font-medium" href={sitePath(`archive/${digest.date}/`)}>查看当日日报</a></header>
        <div class="mt-5 grid gap-7 xl:grid-cols-2">
          {([["paper", "论文", papers], ["blog", "工程博客", blogs]] as const).map(([kind, label, items]) => (
            <section data-archive-kind-section>
              <h3 class="mb-3 inline-flex items-center gap-2 text-sm font-semibold text-slate-700">{kind === "paper" ? <BookOpen size={17} stroke-width={1.8} aria-hidden="true" /> : <Newspaper size={17} stroke-width={1.8} aria-hidden="true" />}{label} · {items.length}</h3>
              <div class="grid gap-3">
                {items.map(({ item }) => (
                  <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)]" data-archive-item data-kind={item.kind} data-year={item.published_at.slice(0, 4)} data-targets={item.targets.join(" ")} data-scenarios={item.scenarios.join(" ")} data-tasks={item.tasks.join(" ")} data-methods={item.methods.join(" ")}>
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500"><span class:list={["rounded-full border px-2 py-0.5 font-semibold", item.kind === "paper" ? "border-sky-200 bg-sky-50 text-sky-800" : "border-emerald-200 bg-emerald-50 text-emerald-800"]}>{item.kind === "paper" ? "论文" : "博客"}</span><time datetime={item.published_at}>{item.published_at.slice(0, 10)}</time></div>
                    <h4 class="mt-3 font-semibold leading-6 text-slate-950"><a href={itemPath(item)}>{item.title}</a></h4>
                    <p class="mt-2 text-sm leading-6 text-slate-600">{item.summary_zh}</p>
                    <TaxonomyChips item={item} taxonomy={data.taxonomy} class="mt-4" />
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    ))}
  </div>
  <p id="archive-empty" class="mt-10 hidden rounded-lg border border-dashed border-slate-300 bg-white px-5 py-10 text-center text-slate-500">没有符合当前筛选条件的推荐。</p>
  <script>
    const form = document.querySelector<HTMLFormElement>("#archive-filters");
    const status = document.querySelector<HTMLElement>("#archive-status");
    const empty = document.querySelector<HTMLElement>("#archive-empty");
    const year = form?.querySelector<HTMLSelectElement>("select[data-archive-year]");
    const groups = [...document.querySelectorAll<HTMLElement>("[data-archive-group]")];
    const taxonomyGroups = ["targets", "scenarios", "tasks", "methods"];

    const applyFilters = () => {
      if (!form) return;
      const selected = new Map<string, Set<string>>();
      for (const input of form.querySelectorAll<HTMLInputElement>("input[data-archive-filter]:checked")) {
        const group = input.dataset.archiveFilter;
        if (!group) continue;
        if (!selected.has(group)) selected.set(group, new Set());
        selected.get(group)?.add(input.value);
      }
      let visible = 0;
      for (const group of groups) {
        let groupVisible = 0;
        for (const row of group.querySelectorAll<HTMLElement>("[data-archive-item]")) {
          const kinds = selected.get("kind");
          const matchesKind = !kinds?.size || kinds.has(row.dataset.kind ?? "");
          const matchesYear = !year?.value || row.dataset.year === year.value;
          const matchesTaxonomy = taxonomyGroups.every(taxonomyGroup => {
            const values = selected.get(taxonomyGroup);
            if (!values?.size) return true;
            const rowValues = new Set((row.dataset[taxonomyGroup] ?? "").split(" ").filter(Boolean));
            return [...values].some(value => rowValues.has(value));
          });
          row.hidden = !(matchesKind && matchesYear && matchesTaxonomy);
          if (!row.hidden) { visible += 1; groupVisible += 1; }
        }
        for (const section of group.querySelectorAll<HTMLElement>("[data-archive-kind-section]")) section.hidden = !section.querySelector("[data-archive-item]:not([hidden])");
        group.hidden = groupVisible === 0;
      }
      if (status) status.textContent = `共 ${visible} 条推荐`;
      empty?.classList.toggle("hidden", visible > 0);
    };
    form?.addEventListener("change", applyFilters);
    form?.addEventListener("reset", () => window.setTimeout(applyFilters));
  </script>
</BaseLayout>
