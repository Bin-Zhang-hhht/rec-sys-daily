---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ItemCard from "../../components/ItemCard.astro";
import { loadBundle, resolveDigestEntries } from "../../lib/data";

export function getStaticPaths() {
  const data = loadBundle();
  return data.digests.map(digest => ({ params: { date: digest.date }, props: { digest, data } }));
}

const { digest, data } = Astro.props;
const papers = resolveDigestEntries(digest.papers, data.byId);
const blogs = resolveDigestEntries(digest.blogs, data.byId);
---
<BaseLayout title={`${digest.date} 日报 · RecSys Daily`}>
  <header class="border-b border-slate-200 pb-6"><p class="text-sm text-sky-700">Daily Digest</p><h1 class="mt-2 text-3xl font-bold">{digest.date} 推荐系统日报</h1><p class="mt-3 text-slate-600">论文 {papers.length} 篇 · 技术博客 {blogs.length} 篇</p></header>
  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <section><h2 class="mb-4 text-xl font-semibold">论文</h2><div class="grid gap-4">{papers.map(({ item, entry }) => <ItemCard item={item} entry={entry} taxonomy={data.taxonomy} />)}</div></section>
    <section><h2 class="mb-4 text-xl font-semibold">技术博客</h2><div class="grid gap-4">{blogs.map(({ item, entry }) => <ItemCard item={item} entry={entry} taxonomy={data.taxonomy} />)}</div></section>
  </div>
</BaseLayout>
