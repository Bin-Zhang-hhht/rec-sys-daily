---
import { ChevronDown, Search, SlidersHorizontal } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadBundle } from "../lib/data";
import { siteBase, sitePath } from "../lib/paths";
const { taxonomy, items } = loadBundle();
const years = [...new Set(items.map(item => item.published_at.slice(0, 4)))].sort().reverse();
const searchIconPath = sitePath("icons/koboyo/search.svg");
---
<BaseLayout title="站内搜索 / RecSys Daily">
  <header class="border-b border-slate-200 pb-4 sm:pb-7">
    <div class="flex items-start gap-3">
      <img src={searchIconPath} alt="" aria-hidden="true" width="40" height="40" class="h-8 w-8 shrink-0 opacity-75 sm:h-10 sm:w-10" />
      <div>
        <p class="hidden text-sm font-semibold text-sky-700 sm:block">Pagefind Extended</p>
        <h1 class="text-2xl font-bold leading-tight text-slate-950 sm:mt-1 sm:text-3xl">站内搜索</h1>
      </div>
    </div>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600 sm:mt-3 sm:text-base sm:leading-7">搜索论文与工程博客的公开摘要和结构化深度解读。</p>
  </header>

  <form id="search-filters" class="mt-4 sm:mt-6">
    <div class="max-w-3xl">
      <label for="search-input" class="sr-only">关键词</label>
      <div class="flex gap-2">
        <input id="search-input" type="search" class="min-h-11 min-w-0 flex-1 rounded-md border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-[0_1px_2px_rgba(15,23,42,0.04)] outline-none placeholder:text-slate-400 focus:border-sky-600 focus:ring-2 focus:ring-sky-100" placeholder="中文或 English terms" autocomplete="off" />
        <button type="submit" class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center gap-1.5 rounded-md bg-slate-900 px-3 text-sm font-semibold text-white hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 sm:px-4" aria-label="提交搜索">
          <Search size={18} stroke-width={1.9} aria-hidden="true" />
          <span class="hidden sm:inline">搜索</span>
        </button>
      </div>
    </div>

    <div class="mt-4 grid gap-5 lg:mt-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-7">
      <details id="search-filter-disclosure" class="group self-start rounded-lg border border-slate-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 px-4 text-sm font-semibold text-slate-800 marker:content-none lg:hidden [&::-webkit-details-marker]:hidden">
          <SlidersHorizontal size={17} stroke-width={1.8} aria-hidden="true" />
          <span>筛选</span>
          <span id="search-active-filter-count" class="hidden rounded-full bg-sky-100 px-2 py-0.5 text-xs font-semibold text-sky-800" aria-live="polite"></span>
          <ChevronDown class="ml-auto transition-transform group-open:rotate-180" size={17} stroke-width={1.8} aria-hidden="true" />
        </summary>

        <div class="search-filter-panel space-y-4 border-t border-slate-200 p-4 lg:space-y-5 lg:border-t-0 lg:p-5">
          <fieldset>
            <legend class="text-sm font-medium text-slate-900">内容类型</legend>
            <div class="mt-2 grid grid-cols-2 gap-x-3 gap-y-2 text-sm lg:grid-cols-1">
              <label class="flex items-start gap-2 text-slate-700"><input class="mt-0.5 h-4 w-4 shrink-0 accent-sky-700" type="checkbox" value="paper" data-filter="kind" /> <span class="leading-5">Paper</span></label>
              <label class="flex items-start gap-2 text-slate-700"><input class="mt-0.5 h-4 w-4 shrink-0 accent-sky-700" type="checkbox" value="blog" data-filter="kind" /> <span class="leading-5">Engineering Blog</span></label>
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-sm font-medium text-slate-900">发布时间</legend>
            <div class="mt-2 grid grid-cols-2 gap-2 text-sm lg:grid-cols-1">
              <label class="block">
                <span class="sr-only">发布年份</span>
                <select data-filter="published_year" class="min-h-10 w-full rounded-md border border-slate-300 bg-white px-2 text-slate-700">
                  <option value="">全部年份</option>
                  {years.map(year => <option value={year}>{year}</option>)}
                </select>
              </label>
              <label class="block">
                <span class="sr-only">发布时间范围</span>
                <select data-filter="age" class="min-h-10 w-full rounded-md border border-slate-300 bg-white px-2 text-slate-700">
                  <option value="">全部时间</option>
                  <option value="7d">最近 7 天</option>
                  <option value="30d">最近 30 天</option>
                  <option value="365d">最近一年</option>
                </select>
              </label>
            </div>
          </fieldset>

          {(["targets", "scenarios", "tasks", "methods"] as const).map(group => (
            <fieldset data-filter-group={group}>
              <legend class="text-sm font-medium text-slate-900">{group}</legend>
              <div class="mt-2 grid grid-cols-2 gap-x-3 gap-y-2 text-sm lg:grid-cols-1">
                {taxonomy[group].map(entry => {
                  const accessibleName = `${entry.name_zh} / ${entry.name_en}`;
                  return (
                    <label class="flex min-w-0 items-start gap-2 text-slate-700" title={accessibleName}>
                      <input class="mt-0.5 h-4 w-4 shrink-0 accent-sky-700" type="checkbox" value={entry.id} data-filter={group} aria-label={accessibleName} />
                      <span class="min-w-0 leading-5">
                        {entry.name_zh}
                        <span class="hidden text-slate-400 lg:inline"> / {entry.name_en}</span>
                      </span>
                      <span class="shrink-0 text-xs leading-5 text-slate-400" data-filter-count={`${group}:${entry.id}`}></span>
                    </label>
                  );
                })}
              </div>
            </fieldset>
          ))}
        </div>
      </details>

      <section class="min-w-0">
        <div class="flex items-center justify-between gap-3 border-b border-slate-200 pb-3">
          <p id="search-status" class="min-w-0 text-sm leading-5 text-slate-500">输入关键词并提交，或直接提交筛选条件。</p>
          <button id="search-more" type="button" class="hidden shrink-0 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium hover:bg-slate-50">加载更多</button>
        </div>
        <div id="search-results" class="mt-3 space-y-3 sm:mt-5 sm:space-y-4" aria-live="polite"></div>
      </section>
    </div>
  </form>

  <span id="search-config" class="hidden" data-site-base={siteBase}></span>
  <script src="../scripts/search.ts"></script>
</BaseLayout>

<style>
  @media (min-width: 64rem) {
    #search-filter-disclosure > .search-filter-panel {
      display: block !important;
    }
  }
</style>
