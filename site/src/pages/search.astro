---
import { Search } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadBundle } from "../lib/data";
import { siteBase } from "../lib/paths";
const { taxonomy, items } = loadBundle();
const years = [...new Set(items.map(item => item.published_at.slice(0, 4)))].sort().reverse();
---
<BaseLayout title="站内搜索 / RecSys Daily">
  <header class="border-b border-slate-200 pb-7"><p class="text-sm font-semibold text-sky-700">Pagefind Extended</p><h1 class="mt-2 text-3xl font-bold leading-tight text-slate-950">站内搜索</h1><p class="mt-3 max-w-3xl leading-7 text-slate-600">搜索论文与工程博客的公开摘要和结构化深度解读。</p></header>
  <div class="mt-6 grid gap-7 lg:grid-cols-[18rem_1fr]">
    <form id="search-filters" class="space-y-5 rounded-lg border border-slate-200 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div><label for="search-input" class="text-sm font-semibold text-slate-800">关键词</label><div class="mt-2 flex gap-2"><input id="search-input" type="search" class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm" placeholder="中文或 English terms" autocomplete="off" /><button type="submit" class="inline-flex min-h-10 shrink-0 items-center justify-center gap-1.5 rounded-md bg-slate-900 px-3 text-sm font-semibold text-white hover:bg-slate-700" aria-label="提交搜索"><Search size={17} stroke-width={1.9} aria-hidden="true" /><span class="hidden sm:inline lg:hidden xl:inline">搜索</span></button></div></div>
      <fieldset><legend class="text-sm font-medium">内容类型</legend><div class="mt-2 space-y-2 text-sm"><label class="block"><input type="checkbox" value="paper" data-filter="kind" /> Paper</label><label class="block"><input type="checkbox" value="blog" data-filter="kind" /> Engineering Blog</label></div></fieldset>
      <fieldset><legend class="text-sm font-medium">发布时间</legend><div class="mt-2 space-y-2 text-sm"><label class="block"><select data-filter="published_year" class="w-full border border-slate-300 px-2 py-1"><option value="">全部年份</option>{years.map(year => <option value={year}>{year}</option>)}</select></label><label class="block"><select data-filter="age" class="w-full border border-slate-300 px-2 py-1"><option value="">全部时间</option><option value="7d">最近 7 天</option><option value="30d">最近 30 天</option><option value="365d">最近一年</option></select></label></div></fieldset>
      {(["targets", "scenarios", "tasks", "methods"] as const).map(group => <fieldset data-filter-group={group}><legend class="text-sm font-medium">{group}</legend><div class="mt-2 space-y-2 text-sm">{taxonomy[group].map(entry => <label class="block text-slate-700"><input type="checkbox" value={entry.id} data-filter={group} /> {entry.name_zh} <span class="text-slate-400">{entry.name_en}</span><span class="ml-1 text-xs text-slate-400" data-filter-count={`${group}:${entry.id}`}></span></label>)}</div></fieldset>)}
    </form>
    <section><div class="flex items-center justify-between gap-3 border-b border-slate-200 pb-3"><p id="search-status" class="text-sm text-slate-500">输入关键词并提交，或直接提交筛选条件。</p><button id="search-more" type="button" class="hidden rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium hover:bg-slate-50">加载更多</button></div><div id="search-results" class="mt-5 space-y-4" aria-live="polite"></div></section>
  </div>
  <span id="search-config" class="hidden" data-site-base={siteBase}></span>
  <script src="../scripts/search.ts"></script>
</BaseLayout>
