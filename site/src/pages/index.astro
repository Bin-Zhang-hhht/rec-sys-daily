---
import BaseLayout from "../layouts/BaseLayout.astro";
import ItemCard from "../components/ItemCard.astro";
import { loadBundle } from "../lib/data";
const data = loadBundle();
const paperItems = data.latestDigest.papers.map(entry => data.byId.get(entry.item_id)).filter(Boolean);
const blogItems = data.latestDigest.blogs.map(entry => data.byId.get(entry.item_id)).filter(Boolean);
---
<BaseLayout title="RecSys Daily · 每日推荐系统研究">
  <section class="border-b border-slate-200 pb-7"><p class="text-sm font-medium text-sky-700">{data.latestDigest.date || "Daily Digest"}</p><h1 class="mt-2 text-3xl font-bold tracking-tight">推荐系统研究日报</h1><p class="mt-3 max-w-3xl text-slate-600">论文与工程实践的结构化中文摘要，保留原始 English titles、algorithms、datasets 和 metrics。</p></section>
  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <section><h2 class="mb-4 text-xl font-semibold">论文 · {paperItems.length}</h2><div class="grid gap-4">{paperItems.map(item => <ItemCard item={item!} taxonomy={data.taxonomy} />)}</div></section>
    <section><h2 class="mb-4 text-xl font-semibold">技术博客 · {blogItems.length}</h2><div class="grid gap-4">{blogItems.map(item => <ItemCard item={item!} taxonomy={data.taxonomy} />)}</div></section>
  </div>
</BaseLayout>
