---
import BaseLayout from "../layouts/BaseLayout.astro";
import ItemCard from "../components/ItemCard.astro";
import { loadBundle, resolveDigestEntries } from "../lib/data";
const data = loadBundle();
const paperItems = resolveDigestEntries(data.latestDigest.papers, data.byId);
const blogItems = resolveDigestEntries(data.latestDigest.blogs, data.byId);
---
<BaseLayout title="RecSys Daily · 每日推荐系统研究">
  <section class="border-b border-slate-200 pb-7">
    <p class="text-sm font-medium text-sky-700">{data.latestDigest.date || "Daily Digest"}</p>
    <h1 class="mt-2 text-3xl font-bold">推荐系统研究日报</h1>
    <p class="mt-3 max-w-3xl text-slate-600">每日汇集推荐系统论文与工程博客，提供中文摘要、结构化解读与实践参考。</p>
  </section>
  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <section><h2 class="mb-4 text-xl font-semibold">论文 · {paperItems.length}</h2><div class="grid gap-4">{paperItems.map(({ item, entry }) => <ItemCard item={item} entry={entry} taxonomy={data.taxonomy} />)}</div></section>
    <section><h2 class="mb-4 text-xl font-semibold">技术博客 · {blogItems.length}</h2><div class="grid gap-4">{blogItems.map(({ item, entry }) => <ItemCard item={item} entry={entry} taxonomy={data.taxonomy} />)}</div></section>
  </div>
</BaseLayout>
